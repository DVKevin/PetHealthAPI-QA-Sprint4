              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Vacina registrada no pet correto', function () {",
                  "    pm.expect(json.petId).to.eql(Number(pm.collectionVariables.get('petId')));",
                  "    pm.expect(json.nome).to.eql('V4 Felina');",
                  "    pm.expect(json.dataProximaDose).to.include(pm.collectionVariables.get('dataProximaDose'));",
                  "});",
                  "pm.collectionVariables.set('vacinaId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }

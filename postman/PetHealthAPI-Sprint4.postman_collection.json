            "url": {
              "raw": "{{baseUrl}}/api/Tutores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Tutores"
              ]
            },
            "description": "Entrada: mesmo e-mail do TC01. Saída esperada: 400 Bad Request com a mensagem de e-mail duplicado.",
            "body": {

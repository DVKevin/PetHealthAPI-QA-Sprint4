                  "    pm.expect(json.mensagem).to.eql('Pet com ID 999999 não encontrado.');",
                  "});",
                  "pm.test('Sem vazamento de detalhes técnicos', function () {",
                  "    const txt = pm.response.text().toLowerCase();",

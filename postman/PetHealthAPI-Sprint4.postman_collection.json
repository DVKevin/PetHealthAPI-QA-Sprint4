              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Dado controlado relativo: próxima dose sempre 10 dias após a execução",
                  "const d = new Date(Date.now() + 10 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('dataProximaDose', d.toISOString().slice(0, 10));"
                ]
              }
            },

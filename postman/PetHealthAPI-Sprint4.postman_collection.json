              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "pm.test('Mensagem de e-mail duplicado', function () {",
                  "    pm.expect(pm.response.json().mensagem).to.eql('Já existe um tutor cadastrado com este email.');",
                  "});"
                ]
              }
